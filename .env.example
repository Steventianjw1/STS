# Copy to .env and fill in locally.
DEEPSEEK_API_KEY=
# Example API root: https://api.deepseek.com
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# Claude: a key from the Claude Console (platform.claude.com, API keys). Needs the anthropic
# package (pip install -e ".[llm]"); pick Claude in the interface's model selector.
ANTHROPIC_API_KEY=
# Only for a key that is not tied to one workspace (the API then asks for the
# anthropic-workspace-id header): that workspace's ID from Console > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Optional, for public Spire Codex statistics. Keyless requests also work.
SPIRE_CODEX_API_KEY=
